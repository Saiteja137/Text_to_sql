DATABASE_PATH=data/college.db
APPROVAL_DB_PATH=data/approvals.db

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=120
MAX_GENERATION_ATTEMPTS=3
QUERY_TIMEOUT_SECONDS=5
MAX_RESULT_ROWS=200
APPROVAL_REQUIRED=false

# Use your own SMTP-enabled sender account; an AI agent has no sender mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_USE_TLS=true
MAIL_FROM=your-email@gmail.com
APPROVER_EMAIL=saitejaatkapuram7@gmail.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-google-app-password
IMAP_POLL_INTERVAL_SECONDS=15
# Approval link points to the React app; use a public HTTPS URL for remote approval.
APPROVAL_BASE_URL=http://localhost:5173/approval
APPROVAL_EXPIRY_MINUTES=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
